{
  "id": "/",
  "name": "Anzol",
  "short_name": "Anzol",
  "description": "Casa de patrimônio — orçamento, investimentos e IR. Instale no celular ou no computador.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070c14",
  "theme_color": "#070c14",
  "categories": ["finance", "business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mês atual",
      "short_name": "Mês",
      "description": "Abrir a apuração do mês",
      "url": "/?view=month"
    },
    {
      "name": "Casa",
      "short_name": "Casa",
      "description": "Orçamento e patrimônio da família",
      "url": "/?view=casa"
    },
    {
      "name": "Carteira",
      "short_name": "Carteira",
      "description": "Posições e cotações",
      "url": "/?view=carteira"
    }
  ]
}
